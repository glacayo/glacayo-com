---
import Box from './Box.astro';
import Icon from './Icon.astro';
import XLogo from './XLogo.astro';
import { categories, type CategoryId } from '../data/categories';
import { categoryUrl, useTranslations, type Lang } from '../i18n/ui';
import { getPostsByLang } from '../lib/posts';

interface Props {
  lang: Lang;
  active?: CategoryId | 'all' | 'saved';
}

const { lang, active } = Astro.props;
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);
const countFor = (id: CategoryId) => posts.filter((post) => post.entry.data.category === id).length;
---

<aside class="sidebar col-sidebar" aria-label="Sidebar">
  <Box title={t('search.title')} as="div" class="search-box">
    <form class="search" role="search" action={`/${lang}/`} data-search-form onsubmit="return false">
      <label class="visually-hidden" for="search-input">{t('search.label')}</label>
      <span class="prompt" aria-hidden="true">&gt;</span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={t('search.placeholder')}
        data-dev-message={t('search.devOnly')}
        data-empty-message={t('search.empty')}
        data-results-label={t('search.results')}
        data-lang={lang}
      />
      <span class="caret" aria-hidden="true"></span>
    </form>
    <div id="search-results" class="search-results" aria-live="polite"></div>
  </Box>

  <Box title={t('sysop.title')} as="div" class="sysop-box">
    <ul class="sysop">
      <li><a href="https://github.com/glacayo" rel="me noopener" target="_blank"><Icon name="github" /> github.com/glacayo</a></li>
      <li><a href="https://x.com/GeovannyLacayo" rel="me noopener" target="_blank"><XLogo /> @GeovannyLacayo</a></li>
    </ul>
  </Box>

  <Box title={t('bases.title')} as="nav" class="bases-box">
    <ul class="bases">
      <li>
        <a href={`/${lang}/`} aria-current={active === 'all' ? 'page' : undefined} data-base-index="0">
          <span class="n">00</span><Icon name="home" /><span class="label">{t('bases.all')}</span><span class="count num">{posts.length}</span>
        </a>
      </li>
      {
        categories.map((category, index) => (
          <li>
            <a
              href={categoryUrl(lang, category.id)}
              aria-current={active === category.id ? 'page' : undefined}
              data-base-index={index + 1}
            >
              <span class="n">{category.number}</span>
              <Icon glyph={category.icon} />
              <span class="label">{category.labels[lang]}</span>
              <span class="count num">{countFor(category.id)}</span>
            </a>
          </li>
        ))
      }
      <li class="saved">
        <a href={`/${lang}/saved/`} aria-current={active === 'saved' ? 'page' : undefined}>
          <span class="n">**</span><Icon name="bookmark" /><span class="label">{t('bases.saved')}</span><span class="count num" data-saved-count></span>
        </a>
      </li>
    </ul>
  </Box>

</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: var(--chrome-size);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--cyan-hi);
  }
  .search input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--cyan-hi);
    font: inherit;
    font-family: var(--font-term);
    padding: 4px 0;
    outline: none;
  }
  .search input::placeholder {
    color: var(--dim);
  }
  .search input::-webkit-search-cancel-button {
    filter: grayscale(1);
  }
  .search:focus-within {
    outline: 2px solid var(--cyan-hi);
    outline-offset: 4px;
  }
  .caret {
    width: 0.6em;
    height: 1.05em;
    background: var(--cyan-hi);
  }
  .search:focus-within .caret,
  .search:has(input:not(:placeholder-shown)) .caret {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.06s steps(1, end) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .search-results:empty {
    display: none;
  }
  .search-results {
    margin-top: 12px;
    border-top: 1px solid var(--rule);
    padding-top: 10px;
  }
  .bases,
  .sysop {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bases a {
    display: grid;
    grid-template-columns: 2.2ch 1.3em minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    padding: 1px 6px;
    margin-inline: -6px;
    line-height: 1.3;
    color: var(--grey);
    text-decoration: none;
  }
  .bases .n {
    color: var(--yellow);
  }
  .bases .label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .bases .count {
    color: var(--dim);
  }
  .bases a:hover {
    color: var(--cyan-hi);
  }
  .bases a[aria-current='page'] {
    background: var(--cyan);
    color: #000;
  }
  .bases a[aria-current='page'] .n,
  .bases a[aria-current='page'] .count {
    color: #000;
  }
  .bases .saved {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
  }
  .sysop li + li {
    margin-top: 6px;
  }
  .sysop a {
    color: var(--grey);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .sysop a:hover {
    color: var(--cyan-hi);
  }

  @media (max-width: 991px) {
    /* Below the grid breakpoint the boxes join the layout grid so the
       message list can sit right after search. */
    .sidebar {
      display: contents;
    }
    .sidebar > :global(.box) {
      grid-column: 1 / -1;
      margin-top: 14px;
    }
    .sidebar > :global(.search-box) {
      order: 0;
    }
    .sidebar > :global(.bases-box) {
      order: 2;
    }
    .sidebar > :global(.sysop-box) {
      order: 3;
    }
    .bases {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 6px;
    }
    .bases li {
      max-width: 100%;
    }
    .bases a {
      display: inline-flex;
      max-width: 100%;
      margin: 0;
      border: 1px solid var(--rule);
      gap: 6px;
    }
    .bases .n,
    .bases .count {
      display: none;
    }
    .bases .saved {
      margin: 0;
      padding: 0;
      border: 0;
    }
    .sysop {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 24px;
    }
    .sysop li + li {
      margin-top: 0;
    }
  }
</style>
