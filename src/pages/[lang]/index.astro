---
import Base from '../../layouts/Base.astro';
import Box from '../../components/Box.astro';
import MessageTable from '../../components/MessageTable.astro';
import { langs, otherLang, useTranslations, type Lang } from '../../i18n/ui';
import { getPostsByLang } from '../../lib/posts';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);
---

<Base lang={lang} alternateUrl={`/${otherLang(lang)}/`} active="all">
  <Box title={t('messages.new')} class="messages-box">
    <MessageTable lang={lang} posts={posts} caption={t('messages.new')} />
  </Box>
</Base>
